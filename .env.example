# Copy to .env and fill in. .env is gitignored and is never committed.
# The test suite runs green with none of these set.

# --- Required for live runs ---
OPENAI_API_KEY=
COHERE_API_KEY=

# --- Models (defaults shown) ---
DETECTIVE_EMBEDDING_MODEL=text-embedding-3-small
DETECTIVE_CHAT_MODEL=gpt-4o-mini
DETECTIVE_RERANK_MODEL=rerank-v3.5

# --- Corpus ---
DETECTIVE_CORPUS_DIR=data
DETECTIVE_CACHE_DIR=.cache

# --- Retrieval tuning (defaults shown) ---
# Hybrid candidates pulled per search round, before reranking.
DETECTIVE_CANDIDATES=15
# Cross-encoder score below which a passage is never admitted as evidence.
DETECTIVE_RERANK_THRESHOLD=0.30
# Passages the agent may admit in a single round.
DETECTIVE_PER_ROUND_EVIDENCE=3
# Ceiling on agent search rounds, so a bad plan cannot loop forever.
DETECTIVE_MAX_ROUNDS=4
# Ceiling on the final evidence set.
DETECTIVE_MAX_EVIDENCE=6

# --- Optional: report archival to S3. Leave blank to disable the feature. ---
DETECTIVE_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
